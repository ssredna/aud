{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	}
	// `#lib` is resolved through the `imports` field in package.json.
	// Other path aliases are handled by https://svelte.dev/docs/kit/configuration#alias
}
